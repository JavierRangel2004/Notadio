PORT=8787
WEB_ORIGIN=http://localhost:5173

# Relative paths are resolved from the project root.
STORAGE_ROOT=./data

FFMPEG_PATH=ffmpeg
WHISPER_COMMAND=whisper-cli
WHISPER_MODEL_PATH=./.local/models/ggml-large-v3.bin
WHISPER_ARGS=-m "{model}" -f "{input}" --output-json --output-srt --output-file "{outputBase}" --language auto
WHISPER_TRANSLATE_ARGS=-m "{model}" -f "{input}" --output-json --output-file "{outputBase}" --language auto --translate
WHISPER_PERF_PROFILE=auto
WHISPER_THREADS=
WHISPER_ENABLE_VAD=true
WHISPER_VAD_MODEL_PATH=./.local/models/ggml-silero-v6.2.0.bin
WHISPER_HALLUCINATION_GUARD=true
WHISPER_MAX_CONTEXT=0
WHISPER_MAX_LEN=160
WHISPER_SPLIT_ON_WORD=true
WHISPER_SUPPRESS_NST=true
WHISPER_NO_SPEECH_THOLD=0.72
WHISPER_VAD_THRESHOLD=0.5
WHISPER_VAD_MIN_SPEECH_MS=250
WHISPER_VAD_MIN_SILENCE_MS=350
WHISPER_VAD_SPEECH_PAD_MS=120
ENABLE_ENGLISH_TRANSLATION=true
TRANSLATION_STRATEGY=whisper-first
JOB_LOG_LIMIT=300

# Leave diarization disabled until you run `bash scripts/setup-diarization.sh`.
DIARIZATION_COMMAND=
DIARIZATION_ARGS="{projectRoot}/scripts/diarize_audio.py" --input "{input}" --output "{outputFile}" --min-speakers "{minSpeakers}" --max-speakers "{maxSpeakers}"
# Expected speaker count bounds (passed as hints to the diarize engine).
# Set DIARIZATION_MIN_SPEAKERS and DIARIZATION_MAX_SPEAKERS to the realistic range
# for your recordings. For a team daily with 5-8 people set MAX to 8 or higher.
DIARIZATION_MIN_SPEAKERS=1
DIARIZATION_MAX_SPEAKERS=8

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
ENABLE_SUMMARY=true
SUMMARY_CHUNK_CONCURRENCY=2
SUMMARY_REDUCE_MIN_PARTIALS=3
SUMMARY_DIRECT_CHAR_LIMIT=12000
SUMMARY_CHUNK_CHAR_LIMIT=8000
SUMMARY_MAX_INPUT_CHARS=48000
SUMMARY_BLOCK_MAX_CHARS=420
SUMMARY_OLLAMA_NUM_CTX=8192
SUMMARY_OLLAMA_NUM_PREDICT=1024
SUMMARY_OLLAMA_KEEP_ALIVE=0

WHISPER_PARALLEL=false
MAX_CONCURRENT_JOBS=1

# Upload / disk safeguards for large media jobs.
# UPLOAD_MAX_BYTES defaults to 12 GiB. MIN_FREE_DISK_BYTES reserves headroom on STORAGE_ROOT.
UPLOAD_MAX_BYTES=12884901888
MIN_FREE_DISK_BYTES=10737418240
DISK_SPACE_JOB_MULTIPLIER=2.2
DISK_SPACE_FIXED_HEADROOM_BYTES=536870912

# --- Live Session (Real-Time Transcription) ---
# Set LIVE_TRANSCRIPTION_ENABLED=false to disable the WebSocket endpoint entirely.
LIVE_TRANSCRIPTION_ENABLED=true

# Rolling audio window size (ms) used for each live transcription pass.
LIVE_WINDOW_MS=20000

# How often (ms) a new transcription window is triggered.
LIVE_INTERVAL_MS=2500

# Overlap (ms) between consecutive windows to preserve context across boundaries.
LIVE_OVERLAP_MS=5000

# Whisper CPU threads used per live window (keep low to avoid starving batch jobs).
LIVE_WHISPER_THREADS=2

# Max number of simultaneous whisper processes across all live sessions.
LIVE_MAX_CONCURRENT_WINDOWS=2

# Minimum audio (ms) before the first transcription window is triggered.
LIVE_MIN_WINDOW_MS=5000

# Time (ms) to accumulate context after an alias mention before classifying intent.
LIVE_MENTION_CONTEXT_WINDOW_MS=5000

# Grace period (ms) to reconnect before a disconnected session is auto-finalized.
LIVE_SESSION_GRACE_PERIOD_MS=30000

# Set to true to enable Ollama-powered reply suggestions for alias mentions.
# Requires OLLAMA_BASE_URL and OLLAMA_MODEL to be configured.
LIVE_ASSISTANT_ENABLED=false

# --- Live Translation (Real-Time Subtitle Translation) ---
# Translates confirmed live transcript segments for subtitle display.
# Does NOT alter the original transcript. Requires an LLM provider.
LIVE_TRANSLATION_ENABLED=false
LIVE_TRANSLATION_SOURCE_LANG=en
LIVE_TRANSLATION_TARGET_LANG=es
LIVE_TRANSLATION_MAX_BATCH=4

# Separate Whisper model for live windows.
# Live transcription uses a smaller/faster model so each 20-second window
# finishes before the next interval fires. The final batch transcription
# (after the session ends) uses the higher-quality WHISPER_MODEL_PATH.
# Leave unset to use WHISPER_MODEL_PATH for both.
LIVE_WHISPER_MODEL_PATH=

# --- LLM Provider Abstraction ---
# By default all LLM features use the global OLLAMA_BASE_URL / OLLAMA_MODEL above.
# You can override per service with these env vars. Service keys:
#   SUMMARY, LIVE_ASSISTANT, LIVE_TRANSLATION, TRANSLATION, DIARIZATION
#
# Provider types: "ollama" (default) or "openai-compatible"
# Example — use a remote OpenAI-compatible API for summaries:
#   LLM_SUMMARY_PROVIDER=openai-compatible
#   LLM_SUMMARY_BASE_URL=https://api.groq.com/openai/v1
#   LLM_SUMMARY_API_KEY=gsk_...
#   LLM_SUMMARY_MODEL=llama-3.3-70b-versatile
#
# Global fallback for openai-compatible providers (used when no service-specific override):
# LLM_OPENAI_BASE_URL=
# LLM_OPENAI_API_KEY=
